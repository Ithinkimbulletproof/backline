# Copy to .env and adjust. Relative paths are resolved against the directory you run
# commands from (the repository root). Nothing below is ever committed.

# Behaviour profile (YAML)
BACKLINE_CONFIG=configs/base.yaml

# Imported songs, the catalog and caches
BACKLINE_DATA_DIR=data
# Your tab library (.gp, .gp3-.gp5, .mid), scanned recursively by `backline ingest`
BACKLINE_TABS_DIR=data/tabs
# Tokenized datasets, originality index, reports
BACKLINE_ARTIFACTS_DIR=artifacts
# Base model checkpoints
BACKLINE_CHECKPOINTS_DIR=checkpoints
# Cached LoRA adapters
BACKLINE_ADAPTERS_DIR=adapters
# Uploaded riffs and exported MIDI from the web UI
BACKLINE_MEDIA_DIR=media

# Web UI
# Name in the header and the page titles
BACKLINE_SITE_NAME=Backline
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
